# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD
POSTGRES_DB=shoppinglist

# JWT Configuration
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING

# Ollama Configuration
OLLAMA_MODEL=llama3.2
# Alternatives: llama3.1, mistral, codellama, etc.

# Authentication
# Who needs to log in:
#   full  - login for everything (default)
#   admin - the shopping list is open, settings and administration need a login
#   none  - no login at all
AUTH_MODE=full

# Older switch, same as AUTH_MODE=none. Ignored when AUTH_MODE is set.
DISABLE_AUTH=false

# Application Configuration
APP_PORT=3000
NODE_ENV=production

# Optional: External access (if behind reverse proxy)
# PUBLIC_URL=https://shopping.yourdomain.com
